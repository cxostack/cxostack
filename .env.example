# cxostack environment variables
# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# Required: Claude API access (or use `claude auth` for subscription-based access)
ANTHROPIC_API_KEY=

# Optional: Groq API for cheap-tier developer agents
GROQ_API_KEY=

# Required: GitHub token for PR creation and repo management via gh CLI
GITHUB_TOKEN=

# Default model tier: best | avg | cheap  (default: avg)
DEFAULT_MODE=avg
